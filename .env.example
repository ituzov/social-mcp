# Defaults to the OS user data directory when this setting is omitted.
# Uncomment to choose a different SQLite path.
# Relative paths are resolved from the process working directory.
# SOCIAL_MCP_DB_PATH=./data/social-mcp.sqlite3

# Public GitHub release checks on tool calls, cached for six hours per process.
# Uncomment to disable both automatic and explicit update checks.
# SOCIAL_MCP_CHECK_UPDATES=false
